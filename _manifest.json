{
  "manifest_version": 2,
  "id": "org.orge-8.group-welcome",
  "version": "1.3.0",
  "name": "群新人欢迎",
  "description": "群聊新人欢迎：识别入群提示或成员首次发言，唤醒 Maisaka Planner 由 LLM 结合人格自主决定欢迎方式（不硬编码欢迎语）。含落盘去重、同群冷却与每小时配额；管理命令 /欢迎 支持状态查询、开关、重置档案与手动测试。",
  "author": {
    "name": "orge-8",
    "url": "https://github.com/orge-8"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/orge-8/group-welcome"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "chat.get_stream_by_group_id",
    "maisaka.proactive.trigger",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  },
  "plugin_type": "extension"
}
